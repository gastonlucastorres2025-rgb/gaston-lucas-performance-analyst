  "muestra": {
    "criterio": "Últimos 6 partidos disponibles (status=available) del equipo, ordenados por fecha descendente.",
    "razon": "El fútbol cambia a corto plazo (cambios de DT, lesiones, ajustes tácticos); una muestra reciente representa mejor al rival que el acumulado anual completo.",
    "agregacion": "Promedio simple por partido de la muestra. Los campos con unit '%' vienen de la API como fracción 0-1 y se escalan x100 al mostrarse."
  },
  "metrics": [
    {
      "id": "goalsPerMatch",
      "name": "Goles por partido",
      "fase": "identidad",
      "formula": "avg(team_match_goals)",
      "unit": "goles/partido",
      "source": "team_match_goals"
    },
    {
      "id": "goalsConcededPerMatch",
      "name": "Goles recibidos por partido",
      "fase": "identidad",
      "formula": "avg(team_match_goals_conceded)",
      "unit": "goles/partido",
      "source": "team_match_goals_conceded",
      "invert": true
    },
    {
      "id": "gdPerMatch",
      "name": "Diferencia de gol por partido",
      "fase": "identidad",
      "formula": "avg(team_match_gd)",
      "unit": "goles/partido",
      "source": "team_match_gd",
      "interpretation": "Balance directo de resultado — resume rendimiento ofensivo y defensivo en un solo número."
    },
    {
      "id": "xgdPerMatch",
      "name": "Diferencia de xG por partido",
      "fase": "identidad",
